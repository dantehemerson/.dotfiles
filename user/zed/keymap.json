// Zed keymap
//
// For information on binding keys, see the Zed
// documentation: https://zed.dev/docs/key-bindings
//
// To see the default key bindings run `zed: open default keymap`
// from the command palette.
[
  // ---------- Like Neovim Keybindings: -----------------
  // Empty pane, set of keybindings that are available when there is no active editor
  {
    "context": "EmptyPane || SharedScreen",
    "bindings": {
      // Open file finder
      "space space": "file_finder::Toggle",

      // Toggles the file explorer (project panel).
      "space e": "project_panel::ToggleFocus",

      // New file
      "space f n": "workspace::NewFile",

      // Open recent project
      "space f p": "projects::OpenRecent",

      // Quit zed
      "space q q": "zed::Quit",
    },
  },
  // Terminal
  {
    "context": "Workspace",
    "bindings": {
      "ctrl-/": "workspace::ToggleBottomDock",
      "cmd-j": null, // Remove binding: Open Terminal. To force use ctrl+/
    },
  },
  // Find Files
  {
    "context": "vim_mode == normal",
    "bindings": {
      // Double-tap Space opens the file finder (LazyVim-style).
      // A single Space still falls through to the default vim::WrappingRight.
      "space space": "file_finder::Toggle",

      // Toggles the file explorer (project panel).
      "space e": "project_panel::ToggleFocus",

      // C++: Switch between source/header file
      "space c h": "editor::SwitchSourceHeader",
    },
  },
  {
    // Fixes error showing which-key popup
    "context": "(VimControl && !menu)",
    "bindings": {
      "space": null, // Disable the default action vim::WrappingRight
    },
  },
  {
    "context": "Editor && VimControl && !VimWaiting && !menu",
    "bindings": {
      // Refactoring
      "space c r ": "editor::Rename",

      "space c f": "editor::Format",

      // File explorer
      "space e": "workspace::ToggleLeftDock",

      "space w c": "pane::CloseOtherItems",

      // Chat with AI
      "space a a": "agent::ToggleFocus",
      "ctrl-\\": "workspace::ToggleRightDock",
      "cmd-k": "workspace::ToggleRightDock",
      "space a e": "assistant::InlineAssist",
      "cmd-l": "assistant::InlineAssist",
      "space a t": "workspace::ToggleRightDock",
      // Open git and focus git panel to have a file view
      "space g g": [
        "action::Sequence",
        [
          "git_panel::ToggleFocus",
          "git::Diff",
        ],
      ],
      // Lazygit. But enjoying zed's git diff more.
      "space g l": [
        "task::Spawn",
        {
          "task_name": "LazyGit",
          "reveal_target": "center",
        },
      ],

      // Move between buffers
      "H": "pane::ActivatePreviousItem",
      "L": "pane::ActivateNextItem",

      "space ,": "tab_switcher::Toggle",

      // Files:
      "space f f": [
        // Or `ctrl-p`
        "task::Spawn",
        { "task_name": "Television File Finder", "reveal_target": "center" },
      ],

      // Search
      "space /": "workspace::NewSearch",

      "space s s": "outline::Toggle",

      "space g r": [
        "action::Sequence",
        [
          "git::StageAll",
          "git::Commit",
          [
            "workspace::SendKeystrokes",
            // Delete all content of commit before generating the new message
            "g g V G d alt-tab",
          ],
        ],
      ],
    },
  },
  // File panel (netrw)
  {
    "context": "ProjectPanel && not_editing",
    "bindings": {
      "a": "project_panel::NewFile",
      "A": "project_panel::NewDirectory",
      "r": "project_panel::Rename",
      "d": "project_panel::Delete",
      "x": "project_panel::Cut",
      "c": "project_panel::Copy",
      "p": "project_panel::Paste",
      "q": "workspace::ToggleLeftDock",

      "space e": "workspace::ToggleLeftDock",

      // Open file (not permanent)
      "tab": "project_panel::Open",

      // Avoid opening file on space.
      "space": null,
    },
  },

  // Window's navigation
  {
    "context": "Dock || Terminal || Editor",
    "bindings": {
      // Window's motions
      "ctrl-h": "workspace::ActivatePaneLeft",
      "ctrl-l": "workspace::ActivatePaneRight",
      "ctrl-k": "workspace::ActivatePaneUp",
      "ctrl-j": "workspace::ActivatePaneDown",
    },
  },
  // On closing Zed's git diff, close the git left panel. (Opened on "space g g")
  {
    "context": "GitDiff || EmptyPane",
    "use_key_equivalents": true,
    "bindings": {
      "cmd-w": [
        "action::Sequence",
        [
          "workspace::ToggleLeftDock",
          "pane::CloseActiveItem",
        ],
      ],
    },
  },
]
