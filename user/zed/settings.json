// Zed settings
//
// For information on how to configure Zed, see the Zed
// documentation: https://zed.dev/docs/configuring-zed
//
// To see all of Zed's default settings without changing your
// custom settings, run `zed: open default settings` from the
// command palette (cmd-shift-p / ctrl-shift-p)
{
  "word_diff_enabled": true,
  "proxy": "",
  "debugger": {
    "dock": "right",
  },
  "ssh_connections": [
    {
      "host": "thinkpad",
      "args": [],
      "projects": [
        {
          "paths": ["/home/sova/coding/argus"],
        },
      ],
    },
  ],
  "diff_view_style": "split",
  "agent_servers": {},
  "language_models": {
    "opencode": {
      "show_zen_models": true,
      "show_go_models": true,
      "show_free_models": true,
    },
  },
  "hover_popover_enabled": true,
  "use_on_type_format": true,
  "tab_size": 2,
  "toolbar": {
    "code_actions": false,
  },
  "scrollbar": {
    "selected_symbol": true,
    "show": "system",
  },
  "gutter": {
    "line_numbers": true,
  },
  "sticky_scroll": {
    "enabled": true,
  },
  "cli_default_open_behavior": "new_window",
  "edit_predictions": {
    "allow_data_collection": "no",
    "codestral": {
      "api_url": "https://codestral.mistral.ai",
    },
    "open_ai_compatible_api": {
      "api_url": "http://192.168.3.64:11434",
      "model": "qwen2.5-coder:1.5b-base",
    },
    "provider": "zed",
  },
  "project_panel": {
    "dock": "left",
  },
  "outline_panel": {
    "git_status": true,
    "button": true,
    "dock": "left",
  },
  "collaboration_panel": {
    "dock": "left",
  },
  "agent": {
    "profiles": {
      "plan": {
        "name": "Plan",
        "tools": {},
        "enable_all_context_servers": false,
        "context_servers": {}
      }
    },
    "sidebar_side": "right",
    "notify_when_agent_waiting": "all_screens",
    "play_sound_when_agent_done": "always",
    "default_profile": "write",
    "tool_permissions": {
      "tools": {
        "delete_path": {
          "default": "allow",
        },
        "create_directory": {
          "default": "allow",
        },
        "terminal": {
          "default": "allow",
        },
      },
    },
    "default_model": {
      "provider": "opencode",
      "model": "go/minimax-m3",
      "enable_thinking": false,
    },
    "dock": "right",
    "favorite_models": [
      {
        "provider": "opencode",
        "model": "free/big-pickle",
        "enable_thinking": false,
      },
      {
        "provider": "opencode",
        "model": "go/minimax-m3",
        "enable_thinking": false,
      },
      {
        "provider": "opencode",
        "model": "go/deepseek-v4-flash",
        "enable_thinking": true,
        "effort": "max",
      },
    ],
    "model_parameters": [],
    "commit_message_model": {
      "provider": "opencode",
      "model": "go/minimax-m3",
      "enable_thinking": false,
    },
     "commit_message_instructions": "Use the Conventional Commits format: <type>(<scope>): <description>."
  },
  "tabs": {
    "file_icons": true,
  },
  "title_bar": {
    "show_branch_status_icon": true,
  },
  "git_panel": {
    "default_width": 380.0,
    "button": true,
    "status_style": "icon",
    "show_count_badge": true,
    "file_icons": true,
    "collapse_untracked_diff": false,
    "dock": "left",
    "tree_view": true,
  },
  "terminal": {
    "scrollbar": {
      "show": "always",
    },
    "toolbar": {
      "breadcrumbs": false,
    },
    "font_size": 12.0,
    "font_weight": 300.0,
    "font_family": "Maple Mono",
  },
  "colorize_brackets": true,
  "buffer_font_weight": 400.0,
  "buffer_line_height": {
    "custom": 1.4,
  },
  "buffer_font_family": "Maple Mono",
  "buffer_font_features": {
    "cv01": true,
    "cv03": true,
    "ss03": true
  },
  "icon_theme": {
    "mode": "dark",
    "light": "VSCode Icons for Zed (Dark)",
    "dark": "VSCode Icons for Zed (Dark Official Icons)",
  },
  "which_key": {
    "enabled": true,
    "delay_ms": 500
  },
  "vim_mode": true,
  "vim": {
    "highlight_on_yank_duration": 200,
    "use_system_clipboard": "on_yank",
    "toggle_relative_line_numbers": true,
  },
  "relative_line_numbers": "enabled",
  "telemetry": {
    "diagnostics": false,
    "metrics": false,
  },
  "soft_wrap": "editor_width",
  "base_keymap": "VSCode",
  "ui_font_size": 14.0,
  "buffer_font_size": 12.5,
  "theme": {
    "mode": "dark",
    "light": "Shades Of Purple",
    "dark": "VSCode Dark Modern",
  },
  "theme_overrides": {
    "Shades Of Purple": {
      "element.selected": "#ff0000",
      "element.active": "#ff8c00",
      "element.hover": "#3b3a5a",
      "border.selected": "#ff0000",
      "text.accent": "#ffffff",
      "icon.accent": "#ffffff"
    },
    "Zedokai (Filter Spectrum)": {
      "element.selected": "#ff0000",
      "element.active": "#ff8c00",
      "element.hover": "#3b414d",
      "border.selected": "#ff0000",
      "text.accent": "#ffffff",
      "icon.accent": "#ffffff"
    },
    "VSCode Dark Modern": {
      "vim.normal.background": "#ff0000",
      "vim.insert.background": "#00ff00",
      "vim.visual.background": "#0000ff",
      "vim.visual_line.background": "#0000ff",
      "vim.yank.background": "#ffff00aa"
    }
  },
  "centered_layout": {
    "left_padding": 0.2,
    "right_padding": 0.2
  },

}
