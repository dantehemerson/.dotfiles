// Project tasks configuration. See https://zed.dev/docs/tasks for documentation.
[
  {
    "label": "LazyGit",
    "command": "lazygit -p $ZED_WORKTREE_ROOT",
    "shell": {
      "program": "sh"
    },
    "hide": "on_success",
    "reveal": "always",
    "reveal_target": "center",
    "show_summary": false,
    "show_command": false,
    "allow_concurrent_runs": true,
    "use_new_terminal": true
  },
  {
    "label": "Television File Finder",
    "command": "tv files | xargs -r zed",
    "hide": "always",
    "allow_concurrent_runs": true,
    "use_new_terminal": true,
    "shell": "system"
  },
  {
     "label": "Television Text Finder",
     "command": "tv text | xargs -r zed",
     "hide": "always",
     "allow_concurrent_runs": true,
     "use_new_terminal": true,
     "shell": "system"
   }
]
