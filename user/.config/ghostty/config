# Ignore going fullscreen by mistake
keybind = global:super+enter=ignore

# Cmd+s -> Ctrl+s: to save on nvim
keybind = super+s=text:\x13

# Cmd+d -> Alt+d: to delete buffers on Telescope
keybind = global:cmd+d=text:\x1bd

quick-terminal-position = center
quick-terminal-size = 50%,60%
keybind = global:cmd+§=toggle_quick_terminal

macos-option-as-alt = left

title = Terminator
window-theme = ghostty
window-decoration = none
macos-titlebar-style = hidden
window-padding-x = 0
window-padding-y = 0
window-padding-balance = true
shell-integration = zsh

# theme = django reborn again
# theme = 0x96f
#theme = iTerm2 Dark Background
theme = Material Darker
bold-color = bright

font-family = Maple Mono
# font-family = JetBrainsMono Nerd Font
font-feature = cv01, cv35
font-size = 12
cursor-style-blink = true



# adjust-cursor-thickness = 2

custom-shader = shaders/cursor_warp.glsl
custom-shader = shaders/ripple_cursor.glsl

# crt style:
#custom-shader = shaders/crt.glsl
#custom-shader = shaders/bettercrt.glsl

#custom-shader = shaders/dither.glsl



# Herdr Icon Agent UI: agent logos in the herdr sidebar
font-family = "Herdr Agent Icons Max"
font-codepoint-map = U+E1A0-U+E1B0=Herdr Agent Icons Max
