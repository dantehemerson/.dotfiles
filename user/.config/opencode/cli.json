{
  "$schema": "https://opencode.ai/v2/cli.json",
  "tabs": {
    "mode": "off"
  },
  "theme": {
    "name": "system"
  },
  "diffs": {
    "wrap": "word"
  },
  "session": {
    "sidebar": "hide",
    "scrollbar": true,
    "thinking": "show",
    "permissions": "autoaccept"
  },
  "animations": true,
  "cursor": {
    "style": "line",
    "blinking": true
  },
  "plugins": [
    "./herdr-opencode"
  ],
  "mouse": true
}
